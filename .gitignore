# ============================================================
# MindCare .gitignore
# ============================================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/
*.egg
.venv/
venv/
env/

# Node.js
node_modules/
package-lock.json

# IDE & OS
.vscode/
.idea/
*.swp
*.swo
*~
desktop.ini
Thumbs.db
.DS_Store

# Temporary files
_report_text.txt
*.tmp

# Environment & Secrets
.env
.env.local
*.secret

# Logs
*.log

# PDF/Word report files (large binaries, optional to exclude)
# Remove the comments below if you want to include them in the repo:
# 工程作业报告.pdf
# 工程作业报告.docx

# CodeBuddy
.codebuddy/
